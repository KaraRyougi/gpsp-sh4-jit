--- a/src/cachesim.c
+++ b/src/cachesim.c
@@ -192,0 +193,14 @@
+
+/* Benchmark-only host instrumentation: no emulated state or cycle changes. */
+void cacheSimDebugChar(char c)
+{
+  static char line[256];
+  static unsigned n;
+  if (!getenv("HLE_CACHESIM_WINDOW")) return;
+  if (c == '\n') {
+    line[n] = 0;
+    if (strstr(line, "loaded OK; running ")) cs_report("window-start");
+    if (strstr(line, "@@CGBA_PROFILE_STOP === done ===")) cs_report("window-end");
+    n = 0;
+  } else if (n < sizeof(line) - 1) line[n++] = c;
+}
